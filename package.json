{
  "name": "gate-control",
  "version": "1.0.2",
  "description": "Windows desktop client for Gate Control",
  "author": "Gate Control",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i ./styles.css -o ./public/app.css --minify",
    "desktop": "electron .",
    "desktop:server": "electron . --run-server",
    "package:desktop": "npm run build:css && electron-builder --win portable --x64",
    "package:server": "npm run build:css && electron-builder --config desktop/server-builder.yml --win portable --x64"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "node": "22.12.0",
    "tailwindcss": "^4.3.0"
  },
  "build": {
    "appId": "com.gatecontrol.desktop",
    "productName": "Gate Control",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Gate-Control-${version}.${ext}"
    }
  }
}
